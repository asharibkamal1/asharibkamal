# Copy this file to .env.local and fill in the values. Never commit .env.local.

# Public URL of the site (used for canonical URLs, sitemap, RSS, social cards)
NEXT_PUBLIC_SITE_URL=https://asharibkamal.com

# --- Newsletter (Kit / ConvertKit) ---
# Kit → Settings → Developer → API keys (v4)
KIT_API_KEY=
# Kit → Grow → Landing Pages & Forms → your form → the number in the form URL
KIT_FORM_ID=

# --- Contact form (Resend) ---
# resend.com → API Keys
RESEND_API_KEY=
# Where contact messages are delivered
CONTACT_TO_EMAIL=asharibkamal1@gmail.com
# Sender address. Use onboarding@resend.dev until you verify asharibkamal.com in Resend.
CONTACT_FROM_EMAIL="Website <onboarding@resend.dev>"
